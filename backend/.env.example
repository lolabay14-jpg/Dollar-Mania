# Copy this file to .env and fill in your own values.
# Never commit .env. Never put a real database password in source code.

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-long-random-string
PORT=3000
CORS_ORIGIN=*

# Development accounts only. These are not production passwords.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=replace-with-a-dev-admin-password
DEFAULT_PLAYER_USERNAME=player1
DEFAULT_PLAYER_PASSWORD=replace-with-a-dev-player-password
DEFAULT_PLAYER2_USERNAME=player2
DEFAULT_PLAYER2_PASSWORD=replace-with-a-dev-player-password
STARTING_CREDITS=500
